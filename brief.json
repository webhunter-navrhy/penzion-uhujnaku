  },
  {
   "typ": "odstavec",
   "text": "Ubytování na jednu noc pouze po domluvě (příplatek 500,-Kč)",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Ubytování v době prodloužených víkendů, svátků, prázdnin atd. minimálně na tři noci. Kratší pobyt pouze po domluvě (příplatek 500,-Kč)",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Kola v areálu ve stojanu zdarma, v garáži 50,-Kč/noc/kolo, elektrokola 50,-Kč/noc.",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Ceny neobsahují turistický, obecní poplatek a DPH 12%.",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Až pro šest osob, kde 4 lůžka na dřevěném patře a 2 lůžka na rozkládací pohovce. Všechna lůžka jsou plnohodnotná (ortopedická matrace 80-90x200cm).",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "cena za pokoj/noc: pro 2 osoby 2.000,-Kč (při nepoužití lůžek v patře), pro 3-4 osoby 3.200,-Kč, pro 5 osob 4.000,-Kč, pro 6 osob 4.600,-Kč",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Až pro tři osoby, kde 2 lůžka na dřevěném patře a 1 lůžko samostatná postel. Všechna lůžka jsou plnohodnotná (ortopedická matrace 80x200cm).",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "cena za pokoj/noc: pro 1 osobu 1.400,-Kč (při nepoužití lůžek v patře), pro 2 osoby 2.000,-Kč, pro 3 osoby 2.800,-Kč",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Až pro sedm osob, kde 2 a 3 lůžka na dřevěném patře a 2 lůžka na rozkládací pohovce. Všechna lůžka jsou plnohodnotná (ortopedická matrace 80x200cm).",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "cena za pokoj/noc: pro 2 osoby 2.000,-Kč (při nepoužití lůžek v patrech), pro 3-4 osoby 3.200,-Kč (při nepoužití lůžek v patře nad kuchyní), pro 5 osob 4.000,-Kč, pro 6 osob 4.600,-Kč pro 7 osob 5.000,-Kč",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Až pro čtyři osoby - manželská postel a 2 lůžka na rozkládací pohovce. Všechny lůžka jsou plnohodnotná (ortopedická matrace 80x200cm).",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "cena za pokoj/noc: pro 2 osoby 2.000,-Kč, pro 3 osoby 2.800,-Kč, pro 4 osoby 3.200,-Kč",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Až pro čtyři osoby – manželské postele a 2x samostatná postel s možností přisunutí k sobě (ortopedické matrace 80x200cm).",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "cena za pokoj/noc: pro 2 osoby 2.000,-Kč, pro 3-4 osoby 3.200,-Kč",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Pro dvě osoby - 2x samostatná postel s možností přisunutí k sobě (ortopedické matrace 80x200cm).",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Součástí každého pokoje/apartmánu je plně vybavená kuchyňka (mikrovlnka, indukční deska, varná konvice, lednice, nádobí, kávovar na kapsle TASSIMO atd.), kompletní sociální zařízení (sprchový kout, toaleta, umyvadlo), kabelová TV, klimatizace a připojení WiFi.",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Přímo v penzionu je vinný sklípek s posezením pro cca 8 osob s 10 odrůdami vín s volným přístupem, zahradní posezení, uložení kol a možnost parkování před penzionem na soukromém parkovišti zdarma.",
   "zdroj": "http://www.penzionuhujnaku.cz/"
  },
  {
   "typ": "odstavec",
   "text": "V zahradě je zastřešený vyhřívaný bazén se slanou vodou 8x4x1,5m, lehátka, sauna.",
